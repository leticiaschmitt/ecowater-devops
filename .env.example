# Copie para .env e ajuste os valores:  cp .env.example .env
COMPOSE_PROJECT_NAME=ecowater
ASPNETCORE_ENVIRONMENT=Development
API_PORT=8080
API_IMAGE=ecowater-api:local

# Banco de dados (SQL Server 2022) - senha precisa ter 8+ caracteres, maiúscula, minúscula, número e símbolo
DB_NAME=EcoWaterDb
DB_PASSWORD=Troque@EstaSenha123

# JWT - chave com pelo menos 32 caracteres
JWT_KEY=troque-esta-chave-por-uma-com-mais-de-32-caracteres
JWT_ISSUER=EcoWaterApi
JWT_AUDIENCE=EcoWaterUsers
