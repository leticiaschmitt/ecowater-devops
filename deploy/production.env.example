# Ambiente de PRODUÇÃO - gerado automaticamente pelo pipeline a partir dos secrets
COMPOSE_PROJECT_NAME=ecowater-production
ASPNETCORE_ENVIRONMENT=Production
API_PORT=8080
API_IMAGE=ghcr.io/<usuario>/<repositorio>:<sha>
DB_NAME=EcoWaterDb
DB_PASSWORD=<secret DB_PASSWORD do environment production>
JWT_KEY=<secret JWT_KEY do environment production>
