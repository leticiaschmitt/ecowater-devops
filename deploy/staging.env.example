# Ambiente de STAGING (homologação) - gerado automaticamente pelo pipeline a partir dos secrets
COMPOSE_PROJECT_NAME=ecowater-staging
ASPNETCORE_ENVIRONMENT=Staging
API_PORT=8081
API_IMAGE=ghcr.io/<usuario>/<repositorio>:<sha>
DB_NAME=EcoWaterDb_Staging
DB_PASSWORD=<secret DB_PASSWORD do environment staging>
JWT_KEY=<secret JWT_KEY do environment staging>
