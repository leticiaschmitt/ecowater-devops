{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "name",
    "location",
    "maxConsumptionLimit",
    "isActive",
    "createdAt"
  ],
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 1
    },
    "name": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "maxConsumptionLimit": {
      "type": "number"
    },
    "isActive": {
      "type": "boolean"
    },
    "createdAt": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
